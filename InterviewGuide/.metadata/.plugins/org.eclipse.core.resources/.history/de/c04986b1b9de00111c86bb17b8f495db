//Problem 3

#include <stdio.h>
#include <stdlib.h>

typedef struct Node {
    int data;
    struct Node *next;
} Node_t;

Node_t *createNode(int value) {
    Node_t *n = (Node_t *)malloc(sizeof(Node_t));
    n->data = value;
    n->next = NULL;
    return n;
}

void removeDuplicates(Node_t *head) {
    Node_t *cur = head;
    while (cur != NULL) {
        Node_t *runner = cur;
        while (runner->next != NULL) {
            if (runner->next->data == cur->data) {
                Node_t *dup = runner->next;
                runner->next = dup->next;
                free(dup);
            } else {
                runner = runner->next;
            }
        }
        cur = cur->next;
    }
}

void printList(Node_t *head) {
    while (head != NULL) {
        printf("%d -> ", head->data);
        head = head->next;
    }
    printf("NULL\n");
}

void freeList(Node_t *head) {
    while (head != NULL) {
        Node_t *temp = head;
        head = head->next;
        free(temp);
    }
}

int main(void) {
    /* Build list: 5 -> 3 -> 5 -> 8 -> 3 -> 9 -> NULL */
    Node_t *head = createNode(5);
    head->next = createNode(3);
    head->next->next = createNode(5);
    head->next->next->next = createNode(8);
    head->next->next->next->next = createNode(3);
    head->next->next->next->next->next = createNode(9);

    printf("Before: ");
    printList(head);

    removeDuplicates(head);

    printf("After:  ");
    printList(head);

    freeList(head);
    return 0;
}
