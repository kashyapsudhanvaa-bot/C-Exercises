//Problem 5

#include <stdio.h>
#include <stdlib.h>

typedef struct Node {
    int data;
    struct Node *next;
} Node_t;

Node_t *createNode(int value) {
    Node_t *n = (Node_t *)malloc(sizeof(Node_t));
    n->data = value;
    n->next = NULL;
    return n;
}

void deleteGivenNode(Node_t *node) {
    if (node == NULL || node->next == NULL) return;
    Node_t *temp = node->next;
    node->data = temp->data;
    node->next = temp->next;
    free(temp);
}

void printList(Node_t *head) {
    while (head != NULL) {
        printf("%d -> ", head->data);
        head = head->next;
    }
    printf("NULL\n");
}

void freeList(Node_t *head) {
    while (head != NULL) {
        Node_t *temp = head;
        head = head->next;
        free(temp);
    }
}

int main(void) {
    /* Build list: 10 -> 20 -> 30 -> 40 -> NULL */
    Node_t *head = createNode(10);
    Node_t *node20 = createNode(20);
    head->next = node20;
    node20->next = createNode(30);
    node20->next->next = createNode(40);

    printf("Before: ");
    printList(head);

    /* Pass only the pointer to node 20 */
    deleteGivenNode(node20);

    printf("After:  ");
    printList(head);

    freeList(head);
    return 0;
}
